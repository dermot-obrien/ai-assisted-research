      "purl": "pkg:generic/dermot-obrien/ai-assisted-research/literature-discovery@1.1.4",
      "requires": [],
      "check": {
        "command": [
          "python",
          "bin/check.py"
        ],
        "runtime": "python",
        "description": "Python 3.10+, PyYAML and requests"
      }
    },
    {
      "name": "research-dag",
      "path": "skills/research-dag",
      "version": "2.0.0",
      "purl": "pkg:generic/dermot-obrien/ai-assisted-research/research-dag@2.0.0",
      "requires": [],
