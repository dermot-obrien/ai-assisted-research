        "command": [
          "python",
          "bin/check.py"
        ],
        "runtime": "python",
        "description": "Python 3.10+, PyYAML, and research.yaml with the paths it names"
      }
    },
    {
      "name": "experiment-vault",
      "path": "skills/experiment-vault",
      "version": "1.0.0",
      "purl": "pkg:generic/dermot-obrien/ai-assisted-research/experiment-vault@1.0.0",
