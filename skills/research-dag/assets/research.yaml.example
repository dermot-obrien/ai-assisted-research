# Research Management System (RMS) workspace config.
# The research skill's start and init flows copy this to the workspace root when no
# research.yaml exists. Edit paths to match your repo.
# All paths are relative to this file's directory (the repo root). Read by
# the research-dag skill (bin/rms_config.py), the research skill and the experiment-vault skill.

# The hypothesis DAG (lineage of ideas) and its computed index.
dag_path: "research/hypothesis-dag.yaml"
node_index_path: "research/node-index.yaml"

# Optional: keep the DAG in a shared, event-sourced store, so several machines and
# agents can change it at once. Set both keys and dag_path becomes a view generated
# from the store; leave them unset to keep the DAG as the plain file above.
# dag_store is a clone's path, or a git URL (or bare repository) to clone into
# ~/.research-dags/. dag_project is this project's folder in the store.
# See the research-dag skill's references/dag-store.md.
# dag_store: "https://example.com/you/research-dags.git"
# dag_project: "my-project"

# Optional: the experiment vault (the experiment-vault skill), where every experiment's
# code, data, environment, command and outputs are kept as a capsule that a later agent can
# replay. uri is a folder or gs://bucket/prefix; project defaults to dag_project.
# See the experiment-vault skill's references/storage.md.
# vault:
#   uri: "gs://your-research-vault/vault"
#   project: "my-project"
#   vendor_wheels: true     # also keep every package's wheel, for replay with no package index
#   rtol: 1.0e-9            # how close a replay's metrics must be, unless a run sets its own
#   atol: 1.0e-12
#   volatile:               # what a replay may change without the result changing: timings and the like
#     keys: ["fit_ms"]      # metric and JSON output keys (name or dotted path globs)
#     outputs: []           # whole output files (path globs)

# Optional: the hypothesis pool (the research skill's references/pool.md), where agents on any
# platform take hypotheses from the thread skill's board. thread is how to run its CLI (or set
# $THREAD_CMD), source the board path, on_thread the thread the calls hang under, and as the
# coordinator's handle (or set $BOARD_AS).
# pool:
#   thread: "node ../thread/skills/thread/bin/thread.mjs"
#   source: "research"
#   on_thread: "t-4k2"
#   as: "coordinator"

# Where AAW work items for research nodes live (your .aaw-config.yaml work_items_path).
work_items_path: ".aaw/work-items/"

dashboard:
  title: "Research Hypothesis Dashboard"
  experiments_dir: "research/experiments"
  breakthroughs: "research/breakthroughs.yaml"
  papers: "research/papers.yaml"
  findings_edges: "research/findings-edges.yaml"
  output_html: "research/dashboard.html"
